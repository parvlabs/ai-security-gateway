# AI Security Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8008
GATEWAY_DEBUG=false

# Provider API Keys (Leave blank to use built-in offline simulation mode)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

ENABLE_MOCK_UPSTREAM=true

# Database Path
SQLITE_DB_PATH=./security_gateway.db

# Rate Limiting Defaults
DEFAULT_RPM=60
DEFAULT_TPM=100000

# Webhooks for Human-in-the-Loop Tool Approvals
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
PUBLIC_GATEWAY_URL=http://localhost:8080
